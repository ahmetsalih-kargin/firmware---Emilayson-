#!/bin/sh

FIRMAE_BOOT=true
FIRMAE_NET=true
FIRMAE_NVRAM=true
FIRMAE_KERNEL=true
FIRMAE_ETC=true

if (${FIRMAE_ETC}); then
  TIMEOUT=360
  CHECK_TIMEOUT=360
else
  TIMEOUT=60
  CHECK_TIMEOUT=60
fi

if [ -n "${FIRMAE_DOCKER-}" ]; then
    FIRMAE_DIR=/work/FirmAE
    PSQL_IP=172.17.0.1
else
    # The directory this file lives in -- not $(pwd): analyses_all.sh and
    # nmap.sh source ../firmae.config from analyses/, where $(pwd) made
    # SCRATCH_DIR point at the non-existent analyses/scratch.
    FIRMAE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
    PSQL_IP=127.0.0.1
fi

BINARIES=( "busybox" "console" "gdb" "gdbserver" "strace" "libnvram.so" "libnvram_ioctl.so" )

# specify full paths to other directories
BINARY_DIR=${FIRMAE_DIR}/binaries/
TARBALL_DIR=${FIRMAE_DIR}/images/
# SCRATCH_DIR should not ends with "/" as we leverage string matching for
# checking image paths in losetup.
SCRATCH_DIR=${FIRMAE_DIR}/scratch
SCRIPT_DIR=${FIRMAE_DIR}/scripts/

# functions to safely compute other paths

check_arch () {
    ARCHS=("armel" "mipseb" "mipsel")

    if [ -z "${1}" ]; then
        return 0
    fi

    match=0
    for i in "${ARCHS[@]}"; do
        if [ "${1}" == "$i" ]; then
            match=1
        fi
    done

    if [ "${match}" -eq 0 ]; then
        return 0
    fi

    return 1
}

check_number () {
    if [ "${1}" -ge 0 ]; then
        return 1
    fi

    return 0
}

check_root () {
    if [ "${EUID}" -eq 0 ]; then
        return 1
    fi

    return 0
}

get_fs () {
    if check_number "${1}"; then
        echo "Error: Invalid image number!"
        exit 1
    fi

    echo "`get_scratch "${1}"`/image.raw"
}

get_fs_mount () {
    if check_number "${1}"; then
        echo "Error: Invalid image number!"
        exit 1
    fi

    echo "`get_scratch "${1}"`/image/"
}

get_kernel () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "${BINARY_DIR}/zImage.${1}"
            ;;
        mipseb)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        mipsel)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_boot_kernel () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "${BINARY_DIR}/vmlinux.${1}"
            ;;
        mipseb)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        mipsel)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_binary () {
    if check_arch "${2}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    echo "${BINARY_DIR}/${1}.${2}"
}

get_qemu () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "qemu-system-arm"
            ;;
        mipseb)
            echo "qemu-system-mips"
            ;;
        mipsel)
            echo "qemu-system-mipsel"
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_qemu_disk () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "/dev/vda1"
            ;;
        mipseb)
            echo "/dev/sda1"
            ;;
        mipsel)
            echo "/dev/sda1"
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_qemu_machine () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "virt"
            ;;
        mipseb)
            echo "malta"
            ;;
        mipsel)
            echo "malta"
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_scratch () {
    if check_number "${1}"; then
        echo "Error: Invalid image number!"
        exit 1
    fi

    echo "${SCRATCH_DIR}/${IID}"
}

# scratch/<IID> belongs to whoever owns scratch/ (the invoking user in Docker
# mode, root otherwise) and nobody else may write to it: root later executes
# scratch/<IID>/run.sh (SECURITY.md S2). docker-helper.py, running as that
# user, still creates and renames files in it.
secure_workdir () {
    chown "$(stat -c %u:%g "${SCRATCH_DIR}")" "${1}"
    chmod 0755 "${1}"
    # undo the world-writable bits older versions set; -xdev keeps us out of a
    # still-mounted firmware image (its own permissions must not change)
    find "${1}" -xdev -perm /022 -exec chmod go-w {} +
}

check_network () {
    sleep 10

    IPS=("${@}")
    DEBUG_MODE=${IPS[-1]}
    unset 'IPS[${#IPS[@]}-1]'

    PING_RESULT=false
    PING_TIME=-1
    WEB_RESULT=false
    WEB_TIME=-1
    RET_IP="None"

    START_TIME=$(date +%s | bc)
    CURRENT_TIME=$(date +%s | bc)
    t_start=$(date +%s.%N)
    while [ ${CURRENT_TIME} -le $[${START_TIME} + ${CHECK_TIMEOUT}] ]
    do
        for IP in "${IPS[@]}"
        do
            if (curl --max-time 2 --output /dev/null --silent http://${IP} || curl --max-time 2 --output /dev/null --silent https://${IP}); then
                t_end=$(date +%s.%N)
                if (! ${WEB_RESULT}); then
                    WEB_TIME=$(echo "$t_end - $t_start" | bc)
                fi
                if (! ${PING_RESULT}); then
                    PING_TIME=${WEB_TIME}
                fi
                PING_RESULT=true
                WEB_RESULT=true
                RET_IP=${IP}
            fi
            if (ping -c 1 ${IP} > /dev/null); then
                t_end=$(date +%s.%N)
                if (! ${PING_RESULT}); then
                    PING_TIME=$(echo "$t_end - $t_start" | bc)
                fi
                PING_RESULT=true
                RET_IP=${IP}
            fi
            sleep 1
            CURRENT_TIME=$(date +%s | bc)
        done

        if (${WEB_RESULT}); then
            break
        fi
    done

    echo "${RET_IP}" "${PING_RESULT}" "${WEB_RESULT}" "${PING_TIME}" "${WEB_TIME}"
}

get_device () {
    echo '/dev/mapper/'`ls -t /dev/mapper | head -1`
}

PARTITION_TIMEOUT=30   # seconds to wait for <loop>p1 to appear

# add_partition <image>: attach the image to a new loop device and print its
# first partition (/dev/loopNp1). losetup --show names exactly the device it
# created; the old code searched `losetup` output by path and, with a leaked
# device for the same image, could pick that one. Gives up after
# PARTITION_TIMEOUT seconds instead of waiting forever.
add_partition () {
    local LOOP DEV_PATH i
    LOOP=`losetup --find --show --partscan "${1}"` || return 1
    DEV_PATH="${LOOP}p1"
    for (( i=0; i<PARTITION_TIMEOUT*2; i++ ))
    do
        if [ -b "${DEV_PATH}" ]; then
            echo ${DEV_PATH}
            return 0
        fi
        sleep 0.5
    done
    echo "Error: ${DEV_PATH} did not appear within ${PARTITION_TIMEOUT}s" >&2
    losetup -d "${LOOP}" &> /dev/null || true
    return 1
}

del_partition () {
    losetup -d ${1} &> /dev/null || true
    dmsetup remove $(basename ${1}) &>/dev/null || true
    sleep 1
}

# ---------------------------------------------------------------------------
# Process and resource lifecycle (REFACTORING_PLAN Phase 3)
# ---------------------------------------------------------------------------

QEMU_STOP_GRACE=10     # seconds between SIGTERM and SIGKILL

# qemu_pids <IID>: PIDs of the QEMU processes emulating this image. A QEMU of
# image <IID> always has ".../scratch/<IID>/image.raw" on its command line, so
# image 1 never matches image 11 and no other emulation is touched. (The old
# `ps aux | grep qemu-system-<arch>` matched every emulation of that
# architecture -- and qemu-system-mips also matched qemu-system-mipsel.)
qemu_pids () {
    pgrep -f -- "(^|/)qemu-system-[^ ]+ .*/scratch/${1}/image\.raw" || true
}

# stop_qemu <IID>: SIGTERM this image's QEMU, SIGKILL it after QEMU_STOP_GRACE.
stop_qemu () {
    local PIDS i
    PIDS=`qemu_pids "${1}"`
    [ -n "${PIDS}" ] || return 0
    kill ${PIDS} 2>/dev/null || true
    for (( i=0; i<QEMU_STOP_GRACE*2; i++ ))
    do
        [ -n "`qemu_pids "${1}"`" ] || return 0
        sleep 0.5
    done
    PIDS=`qemu_pids "${1}"`
    [ -n "${PIDS}" ] && kill -9 ${PIDS} 2>/dev/null
    return 0
}

# wait_for_exit <PID> <seconds>: wait for a process, SIGKILL it at the deadline
# and reap it if it is our child (no zombie is left behind).
wait_for_exit () {
    local i
    for (( i=0; i<${2}*2; i++ ))
    do
        kill -0 "${1}" 2>/dev/null || break
        sleep 0.5
    done
    kill -0 "${1}" 2>/dev/null && kill -9 "${1}" 2>/dev/null
    wait "${1}" 2>/dev/null || true
}

# remove_taps <IID>: delete tap<IID>_<n> and their VLANs tap<IID>_<n>.<vlan>.
remove_taps () {
    local IFACES IFACE
    IFACES=`ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -E "^tap${1}_[0-9]+(\.[0-9]+)?$" || true`
    for IFACE in `echo "${IFACES}" | grep '\.' || true` `echo "${IFACES}" | grep -v '\.' || true`
    do
        ip link delete "${IFACE}" 2>/dev/null || true
    done
}

# release_emulation <IID>: leave nothing of this image behind -- its QEMU, the
# mounted image, every loop device backed by image.raw and its TAP/VLAN
# interfaces. Idempotent; used on every exit path (normal end, error, timeout,
# Ctrl-C, SIGTERM). Touches nothing that belongs to another image.
release_emulation () {
    local IMG="${SCRATCH_DIR}/${1}/image.raw"
    local MNT="${SCRATCH_DIR}/${1}/image"
    local LOOP
    stop_qemu "${1}"
    if mountpoint -q "${MNT}" 2>/dev/null; then
        umount "${MNT}" 2>/dev/null || umount -l "${MNT}" 2>/dev/null || true
    fi
    if [ -e "${IMG}" ]; then
        for LOOP in `losetup -j "${IMG}" 2>/dev/null | cut -d: -f1`
        do
            losetup -d "${LOOP}" 2>/dev/null || true
        done
    fi
    remove_taps "${1}"
    # monitor and serial sockets: QEMU removes them only on a clean exit, not
    # when it is stopped by a signal (measured: 2 sockets left after Ctrl-C/SIGTERM)
    rm -f "/tmp/qemu.${1}" "/tmp/qemu.${1}.S1"
}
