#!/bin/sh

FIRMAE_BOOT=true
FIRMAE_NET=true
FIRMAE_NVRAM=true
FIRMAE_KERNEL=true
FIRMAE_ETC=true

if (${FIRMAE_ETC}); then
  TIMEOUT=360
  CHECK_TIMEOUT=360
else
  TIMEOUT=60
  CHECK_TIMEOUT=60
fi

if [ -n "${FIRMAE_DOCKER-}" ]; then
    FIRMAE_DIR=/work/FirmAE
    PSQL_IP=172.17.0.1
else
    # The directory this file lives in -- not $(pwd): analyses_all.sh and
    # nmap.sh source ../firmae.config from analyses/, where $(pwd) made
    # SCRATCH_DIR point at the non-existent analyses/scratch.
    FIRMAE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
    PSQL_IP=127.0.0.1
fi

# Database port: FIRMAE_DB_PORT from the environment (unset = PostgreSQL's
# default 5432). The Python scripts read it directly; psql (scripts/delete.sh)
# gets it as PGPORT. docker-helper.py passes it into the container.
if [ -n "${FIRMAE_DB_PORT-}" ]; then
    export PGPORT="${FIRMAE_DB_PORT}"
fi

BINARIES=( "busybox" "console" "gdb" "gdbserver" "strace" "libnvram.so" "libnvram_ioctl.so" )

# specify full paths to other directories
BINARY_DIR=${FIRMAE_DIR}/binaries/
TARBALL_DIR=${FIRMAE_DIR}/images/
# SCRATCH_DIR should not ends with "/" as we leverage string matching for
# checking image paths in losetup.
SCRATCH_DIR=${FIRMAE_DIR}/scratch
SCRIPT_DIR=${FIRMAE_DIR}/scripts/

# functions to safely compute other paths

check_arch () {
    ARCHS=("armel" "mipseb" "mipsel")

    if [ -z "${1}" ]; then
        return 0
    fi

    match=0
    for i in "${ARCHS[@]}"; do
        if [ "${1}" == "$i" ]; then
            match=1
        fi
    done

    if [ "${match}" -eq 0 ]; then
        return 0
    fi

    return 1
}

check_number () {
    if [ "${1}" -ge 0 ]; then
        return 1
    fi

    return 0
}

check_root () {
    if [ "${EUID}" -eq 0 ]; then
        return 1
    fi

    return 0
}

get_fs () {
    if check_number "${1}"; then
        echo "Error: Invalid image number!"
        exit 1
    fi

    echo "`get_scratch "${1}"`/image.raw"
}

get_fs_mount () {
    if check_number "${1}"; then
        echo "Error: Invalid image number!"
        exit 1
    fi

    echo "`get_scratch "${1}"`/image/"
}

get_kernel () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "${BINARY_DIR}/zImage.${1}"
            ;;
        mipseb)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        mipsel)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_boot_kernel () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "${BINARY_DIR}/vmlinux.${1}"
            ;;
        mipseb)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        mipsel)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_binary () {
    if check_arch "${2}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    echo "${BINARY_DIR}/${1}.${2}"
}

get_qemu () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "qemu-system-arm"
            ;;
        mipseb)
            echo "qemu-system-mips"
            ;;
        mipsel)
            echo "qemu-system-mipsel"
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_qemu_disk () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "/dev/vda1"
            ;;
        mipseb)
            echo "/dev/sda1"
            ;;
        mipsel)
            echo "/dev/sda1"
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_qemu_machine () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "virt"
            ;;
        mipseb)
            echo "malta"
            ;;
        mipsel)
            echo "malta"
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_scratch () {
    if check_number "${1}"; then
        echo "Error: Invalid image number!"
        exit 1
    fi

    echo "${SCRATCH_DIR}/${IID}"
}

# scratch/<IID> belongs to whoever owns scratch/ (the invoking user in Docker
# mode, root otherwise) and nobody else may write to it: root later executes
# scratch/<IID>/run.sh (SECURITY.md S2). docker-helper.py, running as that
# user, still creates and renames files in it.
secure_workdir () {
    # chown/chmod follow a symlink: whoever can write scratch/ could point
    # scratch/<IID> at e.g. /etc and have root hand it over. -h narrows the
    # race left between this test and the chown.
    if [ -L "${1}" ] || [ ! -d "${1}" ]; then
        echo "Error: ${1} is a symlink or not a directory; refusing to use it" >&2
        return 1
    fi
    chown -h "$(stat -c %u:%g "${SCRATCH_DIR}")" "${1}" || return 1
    chmod 0755 "${1}" || return 1
    # undo the world-writable bits older versions set; -xdev keeps us out of a
    # still-mounted firmware image (its own permissions must not change), and
    # symlinks are skipped (their mode is always 0777 and chmod would change
    # their target). Best effort, as before: a file vanishing meanwhile is no error.
    find "${1}" -xdev ! -type l -perm /022 -exec chmod go-w {} + 2> /dev/null
    return 0
}

# check_network <IP>... <DEBUG_MODE>: wait up to CHECK_TIMEOUT seconds for a
# web service (and ping) on one of the IPs; prints
# "<IP|None> <ping> <web> <ping time> <web time>".
# Only the first CHECK_MAX_IPS addresses are probed: they come from the
# (untrusted) guest, and each one costs several seconds per round.
CHECK_MAX_IPS=8
check_network () {
    local ARG
    IPS=()
    DEBUG_MODE=false
    if [ $# -gt 0 ]; then
        DEBUG_MODE=${!#}
        # empty arguments (e.g. an unknown IP passed as "") are not addresses
        for ARG in "${@:1:$#-1}"; do
            [ ${#IPS[@]} -lt ${CHECK_MAX_IPS} ] || break
            [ -n "${ARG}" ] && IPS+=("${ARG}")
        done
    fi

    PING_RESULT=false
    PING_TIME=-1
    WEB_RESULT=false
    WEB_TIME=-1
    RET_IP="None"

    # nothing to wait for: the loop below would spin at 100% CPU forever
    # (its clock was only advanced inside the per-IP loop)
    if [ ${#IPS[@]} -eq 0 ]; then
        echo "${RET_IP}" "${PING_RESULT}" "${WEB_RESULT}" "${PING_TIME}" "${WEB_TIME}"
        return 0
    fi

    sleep 10

    START_TIME=$(date +%s | bc)
    CURRENT_TIME=$(date +%s | bc)
    t_start=$(date +%s.%N)
    while [ ${CURRENT_TIME} -le $[${START_TIME} + ${CHECK_TIMEOUT}] ]
    do
        for IP in "${IPS[@]}"
        do
            if (curl --max-time 2 --output /dev/null --silent "http://${IP}" || curl --max-time 2 --output /dev/null --silent "https://${IP}"); then
                t_end=$(date +%s.%N)
                if (! ${WEB_RESULT}); then
                    WEB_TIME=$(echo "$t_end - $t_start" | bc)
                fi
                if (! ${PING_RESULT}); then
                    PING_TIME=${WEB_TIME}
                fi
                PING_RESULT=true
                WEB_RESULT=true
                RET_IP=${IP}
            fi
            if (ping -c 1 "${IP}" > /dev/null); then
                t_end=$(date +%s.%N)
                if (! ${PING_RESULT}); then
                    PING_TIME=$(echo "$t_end - $t_start" | bc)
                fi
                PING_RESULT=true
                RET_IP=${IP}
            fi
            sleep 1
            # after every address, not only every round: a round over many
            # addresses must not run far past the deadline (IPS is not empty,
            # so the clock always advances)
            CURRENT_TIME=$(date +%s | bc)
            [ ${CURRENT_TIME} -le $[${START_TIME} + ${CHECK_TIMEOUT}] ] || break
        done

        if (${WEB_RESULT}); then
            break
        fi
    done

    echo "${RET_IP}" "${PING_RESULT}" "${WEB_RESULT}" "${PING_TIME}" "${WEB_TIME}"
}

get_device () {
    echo '/dev/mapper/'`ls -t /dev/mapper | head -1`
}

PARTITION_TIMEOUT=30   # seconds to wait for <loop>p1 to appear

# Docker mode without `--privileged -v /dev:/dev` (docker-helper.py, SECURITY.md
# S7): the container has a /dev of its own (a tmpfs, no udev) and may open loop
# devices (block major 7) only -- no kernel partitions (major 259, which on many
# hosts is also the NVMe disk). So the image is not partition-scanned there: its
# single partition is attached directly, as a loop device with an offset and a
# size limit, and the node of that loop device is made here from the
# major:minor the kernel publishes in /sys. The node is ALSO made under the name
# /dev/loopNp1, because every caller (image.py, emulate.sh, makeNetwork.py)
# strips that "p1" suffix to get the device to detach; both names are the same
# loop device. Nothing of this runs in host mode, nor in Docker mode when /dev
# is the kernel's devtmpfs (FIRMAE_DOCKER_PRIVILEGED=1 shares the host's /dev).
SYS_BLOCK=/sys/block
MOUNTINFO=/proc/self/mountinfo
# Loop devices this container attached ("<device> <inode> <image>" per line).
# Loop devices belong to the kernel, not to the container: one still attached
# when the container is killed stays behind on the Docker host. docker-helper.py
# calls release_container_loops before it stops the container.
LOOP_REGISTRY=/run/firmae-loops

# _manage_dev_nodes: true in Docker mode when /dev is not a devtmpfs
_manage_dev_nodes () {
    local FSTYPE
    [ -n "${FIRMAE_DOCKER-}" ] || return 1
    # the file system type of the last mount on /dev (field after " - ")
    FSTYPE=`awk '$5 == "/dev" { for (i = 7; i <= NF; i++) if ($i == "-") { t = $(i + 1); break } } END { print t }' "${MOUNTINFO}" 2> /dev/null`
    [ -n "${FSTYPE}" ] && [ "${FSTYPE}" != devtmpfs ]
}

# _dev_node <node> <sysfs dev file>: make <node> a block device with the
# major:minor in <sysfs dev file>, which must be a loop device (major 7). An
# existing node with other numbers is replaced: a stale node would open
# somebody else's device.
_dev_node () {
    local MM MAJ MIN
    MM=`cat "${2}" 2> /dev/null` || return 1
    [[ "${MM}" =~ ^7:[0-9]{1,7}$ ]] || return 1
    MAJ=${MM%%:*}
    MIN=${MM#*:}
    if [ -b "${1}" ] && [ "`stat -c '%t:%T' "${1}" 2> /dev/null`" = "`printf '%x:%x' "${MAJ}" "${MIN}"`" ]; then
        return 0
    fi
    rm -f "${1}" && mknod -m 0660 "${1}" b "${MAJ}" "${MIN}"
}

# _image_partition <image>: "<offset> <size>" in bytes of the image's partition.
# makeImage.sh's fdisk script makes a DOS label with one primary Linux
# partition; the guest can rewrite the disk later, so the table is untrusted:
# anything but exactly that (512-byte sectors, one partition of type 83, not
# bootable, inside the file) is refused. The loop device then covers only that
# byte range of the image file.
_image_partition () {
    local DUMP LINE START SIZE FILESIZE N=0 LABEL=0 UNIT=0
    DUMP=`LC_ALL=C sfdisk --dump "${1}" 2> /dev/null` || return 1
    while IFS= read -r LINE
    do
        case "${LINE}" in
            "") ;;
            "label: dos") LABEL=1 ;;
            "label: "*) return 1 ;;
            "unit: sectors") UNIT=1 ;;
            "unit: "*) return 1 ;;
            "sector-size: 512") ;;
            "sector-size: "*) return 1 ;;
            "label-id: "*|"device: "*) ;;
            *" : start="*)
                N=$((N + 1))
                [[ "${LINE}" =~ ^[^[:space:]]+\ :\ start=\ *([0-9]{1,12}),\ size=\ *([0-9]{1,12}),\ type=83$ ]] || return 1
                START=$((10#${BASH_REMATCH[1]}))
                SIZE=$((10#${BASH_REMATCH[2]}))
                ;;
            *) return 1 ;;
        esac
    done <<< "${DUMP}"
    [ ${LABEL} = 1 ] && [ ${UNIT} = 1 ] && [ ${N} = 1 ] || return 1
    [ "${START}" -ge 1 ] && [ "${SIZE}" -ge 1 ] || return 1
    FILESIZE=`stat -L -c %s "${1}" 2> /dev/null` || return 1
    [[ "${FILESIZE}" =~ ^[0-9]+$ ]] || return 1
    [ $(( (START + SIZE) * 512 )) -le "${FILESIZE}" ] || return 1
    echo "$((START * 512)) $((SIZE * 512))"
}

# _attach_partition_loop <image>: attach the image's partition (see
# _image_partition) to a free loop device without --partscan, for a /dev
# without udev. `losetup --find` gets a free device from /dev/loop-control (the
# kernel creates it, /sys shows its numbers); its node is made, then the
# partition is attached to exactly that device. Another container can take the
# same device in between, hence the retries. Prints the device, like --show.
_attach_partition_loop () {
    local i FREE PART OFFSET SIZE
    PART=`_image_partition "${1}"` || { echo "Error: ${1}: unexpected partition table" >&2; return 1; }
    read -r OFFSET SIZE <<< "${PART}"
    for (( i=0; i<5; i++ ))
    do
        FREE=`losetup --find` || return 1
        [[ "${FREE}" =~ ^/dev/loop[0-9]{1,7}$ ]] || return 1
        _dev_node "${FREE}" "${SYS_BLOCK}/${FREE##*/}/dev" || return 1
        if losetup --offset "${OFFSET}" --sizelimit "${SIZE}" --show "${FREE}" "${1}" 2> /dev/null; then
            echo "${FREE} `stat -L -c %i "${1}"` ${1}" >> "${LOOP_REGISTRY}"
            return 0
        fi
        sleep 0.2
    done
    return 1
}

# release_container_loops: detach every loop device in LOOP_REGISTRY that is
# still backed by the very file (inode and path) this container attached --
# never a device that meanwhile belongs to somebody else. A device that is
# still in use (mounted) is detached lazily: the kernel frees it when the last
# user closes it, e.g. when the container's mounts go away.
release_container_loops () {
    local DEV INO IMG NOW
    [ -f "${LOOP_REGISTRY}" ] || return 0
    while read -r DEV INO IMG
    do
        [[ "${DEV}" =~ ^/dev/loop[0-9]{1,7}$ && "${INO}" =~ ^[0-9]+$ ]] || continue
        NOW=`losetup -l -n -O BACK-INO,BACK-FILE "${DEV}" 2> /dev/null | awk '{ print $1, $2 }'`
        [ "${NOW}" = "${INO} ${IMG}" ] || continue
        losetup -d "${DEV}" 2> /dev/null || true
        rm -f "${DEV}p1"
    done < "${LOOP_REGISTRY}"
    rm -f "${LOOP_REGISTRY}"
    return 0
}

# add_partition <image>: attach the image to a new loop device and print its
# first partition (/dev/loopNp1). losetup --show names exactly the device it
# created; the old code searched `losetup` output by path and, with a leaked
# device for the same image, could pick that one. Gives up after
# PARTITION_TIMEOUT seconds instead of waiting forever.
# partition_ready <device>: the partition node exists and the kernel knows its
# size. The node can appear (and be re-created) while udev is still processing
# the new loop device; mounting it at that moment fails with ENOENT. (The old
# code waited until udev had given the node to group "disk"; the first rewrite
# only checked that the node existed, which failed intermittently.)
partition_ready () {
    [ -b "${1}" ] && [ "`blockdev --getsize64 "${1}" 2> /dev/null || echo 0`" -gt 0 ]
}

# mount_partition <device> <directory>: mount, retrying briefly. Right after
# add_partition the node can still be re-created by udev (seen once: mount
# failed with ENOENT although the node had just been found).
# nodev,nosuid: the filesystem holds the untrusted firmware; its device nodes
# (e.g. a /dev/mem copy) must not be openable and its setuid bits must not
# count on the host. Neither stops makeImage.sh: mknod still CREATES nodes
# under nodev (only opening them fails; nothing in inferFile.sh/fixImage.sh
# opens one), and nosuid does not stop the chroot'ed /busybox, /bash-static.
# No noexec: those chroot steps execute from this mount. The guest mounts the
# image itself, so its own view is unaffected.
mount_partition () {
    local i
    for (( i=0; i<5; i++ ))
    do
        mount -o nodev,nosuid "${1}" "${2}" && return 0
        sleep 1
    done
    return 1
}

add_partition () {
    local LOOP DEV_PATH i NODES=0
    _manage_dev_nodes && NODES=1
    if [ ${NODES} = 1 ]; then
        LOOP=`_attach_partition_loop "${1}"` || return 1
        # the "p1" name of the same loop device (see above), for the callers
        _dev_node "${LOOP}p1" "${SYS_BLOCK}/${LOOP##*/}/dev" || { losetup -d "${LOOP}" &> /dev/null; return 1; }
    else
        LOOP=`losetup --find --show --partscan "${1}"` || return 1
    fi
    DEV_PATH="${LOOP}p1"
    for (( i=0; i<PARTITION_TIMEOUT*2; i++ ))
    do
        if partition_ready "${DEV_PATH}"; then
            # let udev finish with the new device, then confirm the node is still there
            command -v udevadm > /dev/null && udevadm settle --timeout=10 2> /dev/null
            if partition_ready "${DEV_PATH}"; then
                echo ${DEV_PATH}
                return 0
            fi
        fi
        sleep 0.5
    done
    echo "Error: ${DEV_PATH} did not appear within ${PARTITION_TIMEOUT}s" >&2
    losetup -d "${LOOP}" &> /dev/null || true
    return 1
}

del_partition () {
    losetup -d ${1} &> /dev/null || true
    dmsetup remove $(basename ${1}) &>/dev/null || true
    # the "p1" name add_partition made for this loop device (Docker mode)
    if _manage_dev_nodes; then rm -f "${1}p1"; fi
    sleep 1
}

# ---------------------------------------------------------------------------
# Process and resource lifecycle (REFACTORING_PLAN Phase 3)
# ---------------------------------------------------------------------------

QEMU_STOP_GRACE=10     # seconds between SIGTERM and SIGKILL

# qemu_pids <IID>: PIDs of the QEMU processes emulating this image of THIS
# installation. Its QEMU has "file=${SCRATCH_DIR}/<IID>/image.raw" in one of
# its arguments (`-drive if=ide,format=raw,file=...`), so the argument fields
# are compared with that exact string -- no regex: another FirmAE copy on the
# host (another SCRATCH_DIR, same IID), image 11 or a path with regex
# characters never match. (pgrep -f ".*/scratch/<IID>/image\.raw" matched every
# installation's QEMU of that IID; the old `ps aux | grep qemu-system-<arch>`
# every emulation of that architecture.) A path spelled differently (symlinked
# directory) still matches when it names the same file (-ef).
qemu_pids () {
    local IMG="${SCRATCH_DIR}/${1}/image.raw" P ARG FIELD FILE
    local -a ARGV FIELDS
    for P in /proc/[0-9]*
    do
        # unreadable or gone in the meantime: not ours to judge
        mapfile -d '' ARGV < "${P}/cmdline" 2> /dev/null || continue
        [ ${#ARGV[@]} -gt 1 ] || continue
        [[ "${ARGV[0]##*/}" == qemu-system-* ]] || continue
        for ARG in "${ARGV[@]:1}"
        do
            [[ "${ARG}" == *file=* ]] || continue
            IFS=, read -r -a FIELDS <<< "${ARG}"
            for FIELD in "${FIELDS[@]}"
            do
                [[ "${FIELD}" == file=* ]] || continue
                FILE=${FIELD#file=}
                if [ "${FILE}" = "${IMG}" ] ||
                   { [[ "${FILE}" == /*"/${1}/image.raw" ]] && [ "${FILE}" -ef "${IMG}" ]; }; then
                    echo "${P#/proc/}"
                    continue 3
                fi
            done
        done
    done
    return 0
}

# scratch_pids <IID>: PIDs of every process of this installation's image
# <IID> (QEMU, run.sh, socat, ...): an argument contains
# "${SCRATCH_DIR}/<IID>/" (fixed string, as in qemu_pids), or a relative
# "scratch/<IID>/" while the process runs in FIRMAE_DIR (run_mode.sh starts
# ./scratch/<IID>/run_debug.sh). Used by scripts/delete.sh; the caller is skipped.
scratch_pids () {
    local DIR="${SCRATCH_DIR}/${1}/" P ARG
    local -a ARGV
    [[ "${1}" =~ ^[0-9]+$ ]] || return 0
    for P in /proc/[0-9]*
    do
        [ "${P#/proc/}" = "$$" ] || [ "${P#/proc/}" = "${BASHPID}" ] && continue
        mapfile -d '' ARGV < "${P}/cmdline" 2> /dev/null || continue
        for ARG in "${ARGV[@]}"
        do
            if [[ "${ARG}" == *"${DIR}"* ]] ||
               { [[ "${ARG}" =~ (^|[:=,])(\./)?scratch/${1}/ ]] && [ "${P}/cwd" -ef "${FIRMAE_DIR}" ]; }; then
                echo "${P#/proc/}"
                continue 2
            fi
        done
    done
    return 0
}

# stop_qemu <IID>: SIGTERM this image's QEMU, SIGKILL it after QEMU_STOP_GRACE.
stop_qemu () {
    local PIDS i
    PIDS=`qemu_pids "${1}"`
    [ -n "${PIDS}" ] || return 0
    kill ${PIDS} 2>/dev/null || true
    for (( i=0; i<QEMU_STOP_GRACE*2; i++ ))
    do
        [ -n "`qemu_pids "${1}"`" ] || return 0
        sleep 0.5
    done
    PIDS=`qemu_pids "${1}"`
    [ -n "${PIDS}" ] && kill -9 ${PIDS} 2>/dev/null
    return 0
}

# wait_for_exit <PID> <seconds>: wait for a process, SIGKILL it at the deadline
# and reap it if it is our child (no zombie is left behind).
wait_for_exit () {
    local i
    for (( i=0; i<${2}*2; i++ ))
    do
        kill -0 "${1}" 2>/dev/null || break
        sleep 0.5
    done
    kill -0 "${1}" 2>/dev/null && kill -9 "${1}" 2>/dev/null
    wait "${1}" 2>/dev/null || true
}

# remove_taps <IID>: delete tap<IID>_<n> and their VLANs tap<IID>_<n>.<vlan>.
remove_taps () {
    local IFACES IFACE
    IFACES=`ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -E "^tap${1}_[0-9]+(\.[0-9]+)?$" || true`
    for IFACE in `echo "${IFACES}" | grep '\.' || true` `echo "${IFACES}" | grep -v '\.' || true`
    do
        ip link delete "${IFACE}" 2>/dev/null || true
    done
}

# ---------------------------------------------------------------------------
# Guest network isolation (TAP mode)
# ---------------------------------------------------------------------------
# In TAP mode the host has an address on tap<IID>_<n> and the guest runs
# untrusted firmware on the other end. Without these rules the guest can open
# connections to every service of the host that listens on that address (or
# on 0.0.0.0), and -- where the host forwards packets, e.g. Docker Desktop's
# WSL distribution has ip_forward=1 -- reach the LAN through the host.
#
# Two rules per address family, matching tap<IID>_+ (the TAP interfaces and
# their VLANs): new connections from the guest to the host are dropped, and
# nothing from the guest is forwarded. Connections the HOST opens to the guest
# (web check, nmap, fuzzer, debug shell) and their replies are not affected.
# The rules are tagged "firmae:<IID>" so exactly this image's rules are removed.

_isolation_rules () {   # _isolation_rules <tool> <IID> <-I|-D>
    "${1}" "${3}" INPUT -i "tap${2}_+" -m conntrack --ctstate NEW         -m comment --comment "firmae:${2}" -j DROP &&
    "${1}" "${3}" FORWARD -i "tap${2}_+"         -m comment --comment "firmae:${2}" -j DROP
}

# _remove_isolation <tool> <IID>: delete this image's rules, however many copies.
_remove_isolation () {
    while _isolation_rules "${1}" "${2}" -D 2> /dev/null; do :; done
    # one rule of the pair may exist without the other (a half-applied set)
    "${1}" -D INPUT -i "tap${2}_+" -m conntrack --ctstate NEW         -m comment --comment "firmae:${2}" -j DROP 2> /dev/null || true
    "${1}" -D FORWARD -i "tap${2}_+" -m comment --comment "firmae:${2}" -j DROP 2> /dev/null || true
}

# isolate_guest_network <IID>: apply the rules. If no firewall tool works the
# emulation still runs (existing installations may lack iptables), but this is
# said loudly and recorded in scratch/<IID>/isolation.
isolate_guest_network () {
    local tool applied=""
    for tool in iptables ip6tables
    do
        command -v ${tool} > /dev/null || continue
        _remove_isolation ${tool} "${1}"
        if _isolation_rules ${tool} "${1}" -I 2> /dev/null; then
            applied="${applied} ${tool}"
        else
            _remove_isolation ${tool} "${1}"
        fi
    done
    if [ -n "${applied}" ]; then
        echo "applied:${applied}" > "${SCRATCH_DIR}/${1}/isolation"
    else
        echo "not applied (no working iptables)" > "${SCRATCH_DIR}/${1}/isolation"
        echo "[-] WARNING: guest network isolation NOT applied: the emulated firmware can reach the host's services. Install iptables." >&2
    fi
    return 0
}

# unisolate_guest_network <IID>: remove this image's rules (idempotent) and
# record how many guest connection attempts they dropped.
unisolate_guest_network () {
    local tool dropped found
    for tool in iptables ip6tables
    do
        command -v ${tool} > /dev/null || continue
        read -r dropped found <<< "`${tool} -L INPUT -v -n -x 2> /dev/null | awk -v tag="firmae:${1}" 'index($0, tag) {n += $1; f++} END {print n + 0, f + 0}'`"
        if [ "${found:-0}" -gt 0 ] && [ -d "${SCRATCH_DIR}/${1}" ]; then
            echo "dropped (${tool} INPUT): ${dropped}" >> "${SCRATCH_DIR}/${1}/isolation"
        fi
        _remove_isolation ${tool} "${1}"
    done
    return 0
}

# release_emulation <IID>: leave nothing of this image behind -- its QEMU, the
# mounted image, every loop device backed by image.raw and its TAP/VLAN
# interfaces. Idempotent; used on every exit path (normal end, error, timeout,
# Ctrl-C, SIGTERM). Touches nothing that belongs to another image.
release_emulation () {
    local IMG="${SCRATCH_DIR}/${1}/image.raw"
    local MNT="${SCRATCH_DIR}/${1}/image"
    local LOOP
    stop_qemu "${1}"
    if mountpoint -q "${MNT}" 2>/dev/null; then
        umount "${MNT}" 2>/dev/null || umount -l "${MNT}" 2>/dev/null || true
    fi
    if [ -e "${IMG}" ]; then
        for LOOP in `losetup -j "${IMG}" 2>/dev/null | cut -d: -f1`
        do
            losetup -d "${LOOP}" 2>/dev/null || true
        done
    fi
    remove_taps "${1}"
    unisolate_guest_network "${1}"
    # monitor and serial sockets: QEMU removes them only on a clean exit, not
    # when it is stopped by a signal (measured: 2 sockets left after Ctrl-C/SIGTERM).
    # The /tmp names are the ones older versions used.
    rm -f "${SCRATCH_DIR}/${1}"/run/*.sock "/tmp/qemu.${1}" "/tmp/qemu.${1}.S1"
}
